# Copy to .env and fill in — .env is git-ignored, never commit real keys.
# Used by the (planned) tools/asset-gen scripts to generate concept art from
# the mockup style guide. Dev-time tooling only: none of this ships in the
# app or touches the Kids Category compliance surface (ADR-002).

# OpenAI API key for image generation (gpt-image-1)
OPENAI_API_KEY=

# ElevenLabs key for audio generation:
# - music + sound effects (may ship in-app; not covered by ADR-003)
# - placeholder Hindi word voiceover for dev builds ONLY — shipped word
#   audio must be a real native speaker per ADR-003
ELEVENLABS_API_KEY=
